[Unit]
Description=VérticeDev content agent (blog con Search Console, Claude Code y Telegram)
Documentation=https://github.com/miguelmartt/vertice-content-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vca
Group=vca
EnvironmentFile=/etc/vertice-content-agent/env
Environment=HOME=/var/lib/vertice-content-agent
Environment=VCA_STATE_DIR=/var/lib/vertice-content-agent
Environment=PATH=/var/lib/vertice-content-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=DISABLE_AUTOUPDATER=1
WorkingDirectory=/opt/vertice-content-agent
ExecStart=/usr/bin/python3 -m vca run
Restart=on-failure
RestartSec=30
TimeoutStopSec=30

# Aislamiento: solo escribe en su carpeta de estado.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/vertice-content-agent
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
