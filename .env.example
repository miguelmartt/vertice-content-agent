# /etc/vertice-content-agent/env (root:vca, 0640). Lo leen systemd y deploy/install.sh.
# Los valores con espacios, entre comillas dobles.

# Telegram: crea el bot con @BotFather; el chat id es el tuyo (escríbele al bot y mira getUpdates).
VCA_TELEGRAM_TOKEN=
VCA_TELEGRAM_CHAT_ID=

# Claude Code con tu suscripción: ejecuta `claude setup-token` en tu ordenador y pega el token.
CLAUDE_CODE_OAUTH_TOKEN=

# Search Console en solo lectura: `python -m vca gsc-auth --client-secrets cliente.json` en tu ordenador.
VCA_GSC_CLIENT_ID=
VCA_GSC_CLIENT_SECRET=
VCA_GSC_REFRESH_TOKEN=
VCA_GSC_SITE=sc-domain:verticedev.es

# GitHub: token fine-grained solo para miguelmartt/verticedev.
# Permisos: Contents (lectura y escritura), Pull requests (lectura y escritura),
# Checks (lectura), Commit statuses (lectura), Metadata (lectura).
VCA_GITHUB_TOKEN=
VCA_GITHUB_REPO=miguelmartt/verticedev
VCA_GITHUB_BASE=main

# Binarios en el VPS.
VCA_PHP_BIN=php83
VCA_GIT_BIN=git
VCA_CLAUDE_BIN=/var/lib/vertice-content-agent/.local/bin/claude

# Modelos (alias de Claude Code) y límites de uso de la suscripción.
VCA_MODEL_PLAN=sonnet
VCA_MODEL_DRAFT=sonnet
VCA_LLM_MAX_CALLS_PER_DAY=20
VCA_LLM_TIMEOUT=900

# Programación (hora de Madrid): plan semanal, medición diaria e informe mensual.
VCA_TIMEZONE=Europe/Madrid
VCA_PLAN_SCHEDULE="mon 08:00"
VCA_LEARN_SCHEDULE=07:30
VCA_REPORT_SCHEDULE="1 09:00"
VCA_PROPOSALS_PER_WEEK=3

# Semillas extra para el autocompletado, separadas por comas.
VCA_SEEDS="agentes de ia para empresas,servidor mcp,automatización de procesos,software a medida murcia,laravel"
VCA_SUGGEST_DELAY=1.0
VCA_SUGGEST_MAX_REQUESTS=300

VCA_SITE_URL=https://verticedev.es
VCA_MIN_WORDS=900
VCA_CI_TIMEOUT_MINUTES=30

# 1 = no sube ramas ni abre PR (para probar). Telegram sigue funcionando.
VCA_DRY_RUN=0
