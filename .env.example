# /etc/vertice-content-agent/env (root:vca, 0640). Lo leen systemd y el atajo `vca`
# como datos, sin pasar por un shell. Los valores con espacios, entre comillas dobles.

# Quién escribe el blog: se usa en los prompts de Claude.
VCA_BRAND=TuMarca
VCA_OWNER=Ana
VCA_AUTHOR="Ana García, desarrolladora freelance en Valencia. Ofrece desarrollo web a medida y automatización para pymes."

# Telegram: crea el bot con @BotFather. El chat id es tu id de usuario: escríbele
# al bot en privado y mira getUpdates. Solo responde a ese usuario en ese chat.
VCA_TELEGRAM_TOKEN=
VCA_TELEGRAM_CHAT_ID=

# Claude Code con tu suscripción: ejecuta `claude setup-token` en tu ordenador y pega el token.
CLAUDE_CODE_OAUTH_TOKEN=

# Search Console en solo lectura: `python -m vca gsc-auth --client-secrets cliente.json` en tu ordenador.
VCA_GSC_CLIENT_ID=
VCA_GSC_CLIENT_SECRET=
VCA_GSC_REFRESH_TOKEN=
VCA_GSC_SITE=sc-domain:example.com
VCA_SITE_URL=https://example.com

# GitHub: token fine-grained solo para el repositorio de la web.
# Permisos: Contents y Pull requests (lectura y escritura); Actions, Commit statuses
# y Metadata (lectura). Los fine-grained no admiten Checks: la CI se lee por Actions.
VCA_GITHUB_TOKEN=
VCA_GITHUB_REPO=tu-usuario/tu-web
VCA_GITHUB_BASE=main
VCA_GIT_AUTHOR_NAME="Content Agent"
VCA_GIT_AUTHOR_EMAIL=content-agent@example.com

# Qué te recuerda que ejecutes cuando fusiona un artículo (vacío: «despliega la web»).
VCA_DEPLOY_COMMAND=

# Binarios en el VPS.
VCA_PHP_BIN=php83
VCA_GIT_BIN=git
VCA_CLAUDE_BIN=/var/lib/vertice-content-agent/.local/bin/claude

# Modelos (alias de Claude Code) y límites de uso de la suscripción.
VCA_MODEL_PLAN=sonnet
VCA_MODEL_DRAFT=sonnet
VCA_LLM_MAX_CALLS_PER_DAY=20
VCA_LLM_TIMEOUT=900

# Programación: plan semanal, medición diaria e informe mensual.
VCA_TIMEZONE=Europe/Madrid
VCA_PLAN_SCHEDULE="mon 08:00"
VCA_LEARN_SCHEDULE=07:30
VCA_REPORT_SCHEDULE="1 09:00"
VCA_PROPOSALS_PER_WEEK=3

# Semillas extra para el autocompletado, separadas por comas.
VCA_SEEDS="desarrollo web a medida,automatización de procesos,laravel"
VCA_SUGGEST_DELAY=1.0
VCA_SUGGEST_MAX_REQUESTS=300

VCA_MIN_WORDS=900
VCA_CI_TIMEOUT_MINUTES=30

# 1 = no sube ramas ni abre PR (para probar). Telegram sigue funcionando.
VCA_DRY_RUN=0
